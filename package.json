{
  "name": "gaurabda-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @gaurabda/core build && pnpm --filter @gaurabda/location build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @gaurabda/core typecheck && pnpm --filter @gaurabda/location typecheck",
    "ci": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-plugin-qwik": "^1.19.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
