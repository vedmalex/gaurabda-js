{
  "name": "gaurabda-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @gaurabda/core build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "ci": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
